# Copy this file to `.env` in this directory (horse_management/). That is
# where settings.py looks for it — a .env in the repository root is NOT read.

# Django settings
# Set DEBUG=True only for local development — never on a server.
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-a-new-one
ALLOWED_HOSTS=localhost,127.0.0.1

# Security
# --------
# Encryption of secrets stored in the database (currently the Xero OAuth
# tokens). Comma-separated Fernet keys, NEWEST FIRST. The first key
# encrypts; every key is tried when decrypting, which is how rotation
# works. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to derive a key from SECRET_KEY. That works, but then
# changing SECRET_KEY forces a Xero reconnect.
# FIELD_ENCRYPTION_KEYS=

# Brute-force protection on sign-in (django-axes). Lockout is keyed on the
# username, so an attacker cannot dodge it by changing IP address.
# Clear a lockout early with: python manage.py axes_reset_username <email>
# AXES_ENABLED=True
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=30

# Content-Security-Policy. Report-only by default: the browser reports what
# the policy would block and blocks nothing. Set True to enforce it, once
# the browser console is quiet.
# CSP_ENFORCE=False

# Redirect plain HTTP to HTTPS (production only, DEBUG=False). On by
# default. Set False only if the proxy in front stops sending
# X-Forwarded-Proto, which would otherwise cause a redirect loop.
# SECURE_SSL_REDIRECT=True

# Database (SQLite used by default in development)
# For production, set:
# DATABASE_URL=postgres://user:password@localhost:5432/horse_management

# Email settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Bulk invoice sending runs one Celery task per invoice. Set to False on a
# host with no worker process (Vercel sets this automatically) to send inline.
INVOICE_SEND_ASYNC=True

# Database connection lifetime (seconds). Ignored on Vercel (forced to 0 for
# serverless). 600 is a good default for always-on hosts like Railway.
CONN_MAX_AGE=600

# Uploaded media. Point at a persistent disk in production
# (e.g. Railway volume mounted at /data -> MEDIA_ROOT=/data/media).
# MEDIA_ROOT=/data/media
# Serve /media/ through Django when DEBUG=False (needed on Railway).
# SERVE_MEDIA=True

# Celery beat schedule times (Europe/London). See settings.py.
# REMINDER_HOUR=7
# REMINDER_MINUTE=0
# REMINDER_DAYS_OF_WEEK=mon-fri
# INVOICE_STATUS_HOUR=6

# Product analytics (PostHog)
# Leave POSTHOG_API_KEY empty to switch analytics off completely.
# The key is the PUBLIC project key from PostHog > Settings > Project. It is
# embedded in the page on purpose and can only write events, never read them.
# POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EU region by default. For a US project use:
#   POSTHOG_HOST=https://us.i.posthog.com
#   POSTHOG_ASSET_HOST=https://us-assets.i.posthog.com
#   POSTHOG_UI_HOST=https://us.posthog.com
# POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_ASSET_HOST=https://eu-assets.i.posthog.com
# POSTHOG_UI_HOST=https://eu.posthog.com
# Session replay. Inputs and page text are always masked; set False to stop
# recording sessions altogether.
# POSTHOG_SESSION_RECORDING=True
# Put usernames in person profiles. Off by default: people can sign in with an
# email address, which is personal data.
# POSTHOG_SEND_USERNAMES=False
# Send server events on the request thread. Auto-on for Vercel.
# POSTHOG_SYNC_MODE=False
# Verbose posthog-js logging in the browser console.
# POSTHOG_DEBUG=False
# Route browser traffic through this app at /ingest/ so ad blockers cannot
# see the tracker. On by default; set False to have browsers talk to
# posthog.com directly.
# POSTHOG_PROXY=True

# Location mapping. Set True to show the nearest-location chip, the Map tab
# on Locations and the Near you dashboard card. The coordinate picker on the
# location edit form and `manage.py backfill_location_coords` work either way.
# LOCATION_MAPS_ENABLED=False
# Metres from a location's point within which the chip names it.
# LOCATION_NEAR_RADIUS_M=150
