# Copy this file to `.env` in this directory (horse_management/). That is
# where settings.py looks for it — a .env in the repository root is NOT read.

# Django settings
# Set DEBUG=True only for local development — never on a server.
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-a-new-one
ALLOWED_HOSTS=localhost,127.0.0.1

# Security
# --------
# Encryption of secrets stored in the database (currently the Xero OAuth
# tokens). Comma-separated Fernet keys, NEWEST FIRST. The first key
# encrypts; every key is tried when decrypting, which is how rotation
# works. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to derive a key from SECRET_KEY. That works, but then
# changing SECRET_KEY forces a Xero reconnect.
# FIELD_ENCRYPTION_KEYS=

# How long a session cookie stays valid, in seconds. Counts from the last
# request, not from sign-in. Default is 7 days.
# SESSION_COOKIE_AGE=604800

# Where the Django admin is mounted. Set this in production to something
# unguessable so the admin is not found by untargeted scanners. A trailing
# slash is added if missing. Changing it changes the address you use to
# reach the admin — note it somewhere before you deploy.
# ADMIN_URL=yard-office-7f3a/

# Brute-force protection on sign-in (django-axes). Lockout is keyed on the
# username, so an attacker cannot dodge it by changing IP address.
# Clear a lockout early with: python manage.py axes_reset_username <email>
# AXES_ENABLED=True
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=30

# Content-Security-Policy. Report-only by default: the browser reports what
# the policy would block and blocks nothing. Set True to enforce it, once
# the browser console is quiet.
# CSP_ENFORCE=False

# Redirect plain HTTP to HTTPS (production only, DEBUG=False). On by
# default. Set False only if the proxy in front stops sending
# X-Forwarded-Proto, which would otherwise cause a redirect loop.
# SECURE_SSL_REDIRECT=True

# Error monitoring (Sentry)
# -------------------------
# Empty means Sentry is off entirely and nothing is reported anywhere.
# The DSN is safe to expose; it can only write events, never read them.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Set automatically from RAILWAY_GIT_COMMIT_SHA on Railway.
# SENTRY_RELEASE=
# Performance tracing. 0.0 = errors only, which is the right setting for
# a yard-sized app; tracing every request burns the free-tier quota.
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Off-site backups
# ----------------
# A database backup does NOT include uploaded media (horse photos,
# passports, insurance documents, receipts). Both are backed up here.
# Restore procedure: docs/BACKUP_RESTORE.md
#
# Use an object store from a DIFFERENT provider than the database. One
# provider is one suspended account away from losing both copies.
# BACKUP_ENABLED=False
# BACKUP_INCLUDE_MEDIA=True

# S3-compatible destination. Cloudflare R2 or Backblaze B2 both work and
# both have a free tier big enough for one yard. Leave the endpoint empty
# for plain AWS S3.
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=yardway-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_REGION=auto

# pg_dump connects with this if set. Needed when the app reaches the
# database through a pooler (Supabase pgbouncer) that pg_dump cannot use —
# point this at the DIRECT connection string instead.
# BACKUP_DATABASE_URL=

# The restore test (docs/BACKUP_RESTORE.md). Both must name somewhere
# scratch — the command refuses to run if the database matches
# DATABASE_URL or BACKUP_DATABASE_URL by host and name, or if the bucket
# is the live media or backup one. No defaults: a restore overwrites
# whatever it is aimed at, so it must be aimed deliberately.
#   python manage.py restore_test --list
#   python manage.py restore_test
# RESTORE_TEST_DATABASE_URL=
# RESTORE_TEST_MEDIA_BUCKET=yardway-restore-test

# Retention: every backup from the last week, then one a week, then one a
# month. Roughly 23 copies, covering both "undo yesterday" and "we only
# noticed two months later".
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=12

# Hour (Europe/London) the nightly backup runs. Before the Xero sweep and
# the invoice and reminder window, so it copies a quiet database.
# BACKUP_HOUR=2
# Seconds before a stuck pg_dump is killed.
# BACKUP_PG_DUMP_TIMEOUT=1800

# Database (SQLite used by default in development)
# For production, set:
# DATABASE_URL=postgres://user:password@localhost:5432/horse_management

# Email settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Bulk invoice sending runs one Celery task per invoice. Set to False on a
# host with no worker process (Vercel sets this automatically) to send inline.
INVOICE_SEND_ASYNC=True

# Database connection lifetime (seconds). Ignored on Vercel (forced to 0 for
# serverless). 600 is a good default for always-on hosts like Railway.
CONN_MAX_AGE=600

# Uploaded media, option 1: a local disk. Point at a persistent volume in
# production (e.g. Railway volume mounted at /data -> MEDIA_ROOT=/data/media).
# MEDIA_ROOT=/data/media
# Serve /media/ through Django when DEBUG=False (needed with a volume).
# SERVE_MEDIA=True

# Uploaded media, option 2 and the better one in production: an
# S3-compatible bucket. Set these four and the app reads and writes
# uploads there instead of the disk; SERVE_MEDIA is then ignored.
#
# Why: a host volume attaches to ONE service. With uploads on a volume the
# nightly backup, which runs on the worker, cannot see files written by
# the web service and silently backs up nothing.
#
# The bucket MUST be private — no public development URL, no custom
# domain. It holds passports, insurance documents and vet records. Links
# are signed per request and expire.
# MEDIA_S3_BUCKET=yardway-media
# MEDIA_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=
# MEDIA_S3_REGION=auto
# Seconds a signed media link stays valid.
# MEDIA_S3_SIGNED_URL_TTL=900
#
# Moving existing uploads across, once the four above are set:
#   python manage.py migrate_media_to_s3 --dry-run
#   python manage.py migrate_media_to_s3

# Celery beat schedule times (Europe/London). See settings.py.
# REMINDER_HOUR=7
# REMINDER_MINUTE=0
# REMINDER_DAYS_OF_WEEK=mon-fri
# INVOICE_STATUS_HOUR=6

# Product analytics (PostHog)
# Leave POSTHOG_API_KEY empty to switch analytics off completely.
# The key is the PUBLIC project key from PostHog > Settings > Project. It is
# embedded in the page on purpose and can only write events, never read them.
# POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EU region by default. For a US project use:
#   POSTHOG_HOST=https://us.i.posthog.com
#   POSTHOG_ASSET_HOST=https://us-assets.i.posthog.com
#   POSTHOG_UI_HOST=https://us.posthog.com
# POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_ASSET_HOST=https://eu-assets.i.posthog.com
# POSTHOG_UI_HOST=https://eu.posthog.com
# Session replay. Inputs and page text are always masked; set False to stop
# recording sessions altogether.
# POSTHOG_SESSION_RECORDING=True
# Put usernames in person profiles. Off by default: people can sign in with an
# email address, which is personal data.
# POSTHOG_SEND_USERNAMES=False
# Send server events on the request thread. Auto-on for Vercel.
# POSTHOG_SYNC_MODE=False
# Verbose posthog-js logging in the browser console.
# POSTHOG_DEBUG=False
# Route browser traffic through this app at /ingest/ so ad blockers cannot
# see the tracker. On by default; set False to have browsers talk to
# posthog.com directly.
# POSTHOG_PROXY=True

# Location mapping. Set True to show the nearest-location chip, the Map tab
# on Locations and the Near you dashboard card. The coordinate picker on the
# location edit form and `manage.py backfill_location_coords` work either way.
# LOCATION_MAPS_ENABLED=False
# Metres from a location's point within which the chip names it.
# LOCATION_NEAR_RADIUS_M=150
