---
/*
  The home page. docs/plan.md, Section 2. Everything on it comes from
  src/content/home/home.json, src/content/settings/site.json and the posts.
*/
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Shelves from '../components/home/Shelves.astro';
import About from '../components/home/About.astro';
import Contact from '../components/home/Contact.astro';

const homeEntries = await getCollection('home');
const home = homeEntries[0]?.data;
if (!home) throw new Error('No home page content found in src/content/home/');

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title={home.title} description={home.description} hero>
  <Hero h1={home.h1} slides={home.slides} />
  <Shelves shelves={home.shelves} />
  <About about={home.about} posts={posts} />
  <Contact contact={home.contact} />
  <script>
    import '../scripts/pageload';
    import '../scripts/hero';
    import '../scripts/about';
    import '../scripts/gallery';
    import '../scripts/form';
  </script>
</Base>
