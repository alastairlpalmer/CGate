---
/*
  A link that looks like a button. 2px radius, the only radius on the site.
  `tone`: fill (teal, white text), line (outline on paper), light (outline on a photograph).
*/
import { inline } from '../../lib/text';

interface Props {
  link: { label: string; href: string };
  tone?: 'fill' | 'line' | 'light';
  class?: string;
}

const { link, tone = 'fill', class: className } = Astro.props;
---

<a class:list={['button', `button--${tone}`, className]} href={link.href}>
  <Fragment set:html={inline(link.label)} />
</a>

<style>
  .button {
    display: inline-block;
    padding: 0.7em 1.4em;
    border: 1px solid var(--teal);
    border-radius: var(--radius-control);
    font-family: var(--font-display);
    font-size: var(--t-small);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .button--fill {
    background: var(--teal);
    color: var(--white);
  }
  .button--fill:hover {
    background: var(--teal-deep);
    border-color: var(--teal-deep);
    color: var(--white);
  }
  .button--line {
    background: transparent;
    color: var(--teal-deep);
    border-color: var(--teal-deep);
  }
  .button--line:hover {
    background: var(--teal-deep);
    color: var(--white);
  }
  .button--light {
    background: transparent;
    color: var(--white);
    border-color: var(--white);
  }
  .button--light:hover {
    background: var(--white);
    color: var(--green);
  }
</style>
